# Kopiuj jako .env NA SERWERZE (nigdy nie commituj prawdziwych wartości).
# Potrzebne tylko tam, gdzie działa panel — strona statyczna ich nie używa.

# Adres strony: kanoniczne linki, mapa strony, przekierowania z panelu.
SITE_URL=https://aw-foto.pl

# Panel: aplikacja GitHub OAuth (Settings → Developer settings → OAuth Apps).
# Callback URL: https://panel.aw-foto.pl/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Losowy ciąg do podpisywania sesji panelu. Wygeneruj:  openssl rand -hex 32
KEYSTATIC_SECRET=

# UWAGA: prywatne repo z treścią NIE jest ustawiane tutaj. Zmienne
# PUBLIC_CONTENT_REPO_OWNER / _NAME są wkompilowywane w panel podczas budowania
# (keystatic.config.ts trafia do przeglądarki, więc import.meta.env jest
# podmieniane na stałe). Wpisanie ich w ten plik nic nie da — ustawia je
# workflow "Build i deploy" ze zmiennych repozytorium CONTENT_REPO_OWNER/_NAME.

# Panel zawsze łączy się z prywatnym repo przez GitHub — także lokalnie.
# Tryb "local" (edycja plików na dysku, bez logowania) działa TYLKO wtedy,
# gdy katalog site-content/ jest śledzony przez gita w tym repozytorium.
# U nas jest w .gitignore, więc w trybie local panel byłby pusty.
# PUBLIC_KEYSTATIC_STORAGE=local

# Ustaw na subdomenie panelu: blokuje indeksowanie i przekierowuje
# wszystko poza /keystatic na właściwą stronę.
PANEL_ONLY=true
