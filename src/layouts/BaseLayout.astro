---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getSettings, getPricing } from '../lib/siteContent';
import { SITE_NAME, businessSchema, cityName } from '../lib/seo';
import { getAnalytics, IGNORE_KEY } from '../lib/analytics';
import '../styles/global.css';

/**
 * Shown when a page has no photograph of its own to share. Built from the logo
 * by scripts/generate-og-card.mjs.
 */
const OG_DEFAULT = '/og-default.jpg';

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative URL of the image used for link previews. */
  ogImage?: string;
  /** `article` for a session, whose page is dated and written. */
  ogType?: 'website' | 'article';
  /** ISO date of a session, for `article:published_time`. */
  publishedTime?: string;
  /**
   * Extra JSON-LD for this page — the breadcrumb trail, the gallery, the
   * service. The business card below is emitted everywhere and referenced by
   * `@id`, so a page only describes what is its own.
   */
  schema?: Record<string, unknown>[];
  /** Keeps the panel subdomain out of Google. */
  noindex?: boolean;
}

const {
  title,
  description = 'Fotografia rodzinna, plenerowa i świąteczna. Sesje zdjęciowe bez pozowania.',
  ogImage = OG_DEFAULT,
  ogType = 'website',
  publishedTime,
  schema = [],
  noindex = false,
} = Astro.props;

const settings = getSettings();
const pricing = getPricing();
const analytics = getAnalytics(Astro.site!);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;

/**
 * The title tag is the single line Google shows, so it has to say the trade
 * and the place — those are what people type. The page's own words come first,
 * then the studio, then the city: "Cennik sesji zdjęciowych — AW Fotografia,
 * Rzeszów". The home page passes a title that already reads that way and is
 * left alone.
 */
const city = cityName(settings.city);
const fullTitle =
  title === SITE_NAME || title.startsWith(`${SITE_NAME} `)
    ? title
    : `${title} — ${SITE_NAME}${city ? `, ${city}` : ''}`;

// Declared only for the card, whose size is known here — a session's cover is
// whatever the photographer uploaded, and a wrong pair is worse than none.
const isDefaultOgImage = ogImage === OG_DEFAULT;

/**
 * Helps Google show the business in local results. Only fields that are
 * actually filled in are emitted, so placeholder data never ships as fact.
 */
const business = businessSchema({
  site: Astro.site!,
  settings,
  pricing,
  description,
  image: new URL(OG_DEFAULT, Astro.site).href,
});

/**
 * One <script> per block, built as a single string: `set:html` is a directive
 * on a template element, so inside a `.map()` it renders as literal markup
 * rather than as the script it describes.
 *
 * `<` is escaped along the way. JSON.stringify leaves it alone, so a `</script>`
 * inside any field the photographer typed would otherwise close the block and
 * spill the rest onto the page.
 */
const jsonLd = [business, ...schema]
  .map(
    (block) =>
      `<script type="application/ld+json">${JSON.stringify(block).replace(/</g, '\\u003c')}</script>`,
  )
  .join('');
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      /* Tells Google it may show the whole preview and a full-size image
         thumbnail, rather than the short default — a photographer's result is
         mostly the picture. */
      !noindex && (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }
    {
      settings.seo.googleSiteVerification && (
        <meta name="google-site-verification" content={settings.seo.googleSiteVerification} />
      )
    }

    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="og:site_name" content="AW Fotografia" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="pl_PL" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {
      isDefaultOgImage && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="AW Fotografia — Alicja Wicherek" />
        </>
      )
    }
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FDFBF7" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- The two faces used above the fold; the rest load on demand. -->
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-300.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/jost-300.woff2" as="font" type="font/woff2" crossorigin />

    {/* `<Fragment set:html>`, not `<set:html>`: the latter parses as an element
        named `set` carrying a `:html` attribute, so the whole block shipped as
        an inert, escaped `<set>` tag and Google never saw any of it. */}
    <Fragment set:html={jsonLd} />

    {
      /* One beacon per page view to Matomo — see src/lib/analytics.ts for why
         this is not matomo.js. Nothing is written to the visitor's browser;
         the only read is the flag /nie-licz-mnie sets in the photographer's
         own. sendBeacon with a form body is a simple CORS request, so it needs
         no preflight and survives the visitor leaving the page. */
      analytics && (
        <script
          is:inline
          define:vars={{ endpoint: analytics.endpoint, siteId: analytics.siteId, ignoreKey: IGNORE_KEY }}
        >
          let ignored = false;
          try {
            ignored = localStorage.getItem(ignoreKey) !== null;
          } catch {}
          if (!ignored && navigator.sendBeacon) {
            navigator.sendBeacon(
              endpoint,
              new URLSearchParams({
                idsite: siteId,
                rec: '1',
                apiv: '1',
                send_image: '0',
                url: location.href,
                urlref: document.referrer,
                action_name: document.title,
              }),
            );
          }
        </script>
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
