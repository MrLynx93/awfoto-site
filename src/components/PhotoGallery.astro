---
import { Image } from 'astro:assets';

/** Sessions and offers both carry photos in this shape. */
export interface GalleryPhoto {
  image: ImageMetadata;
  alt: string;
}

interface Props {
  photos: GalleryPhoto[];
}

const { photos } = Astro.props;
---

{
  photos.length > 0 && (
    <div class="photo-grid" id="photo-grid">
      {photos.map((photo, index) => (
        <button
          class="photo"
          type="button"
          data-lightbox-index={index}
          aria-label={`Powiększ zdjęcie ${index + 1} z ${photos.length}`}
        >
          <Image
            src={photo.image}
            alt={photo.alt}
            widths={[400, 800, 1400]}
            sizes="(max-width: 780px) 50vw, 33vw"
            loading={index < 2 ? 'eager' : 'lazy'}
          />
        </button>
      ))}
    </div>
  )
}

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(0.9rem, 2vw, 1.5rem);
    max-width: var(--max);
    margin: 0 auto;
  }

  .photo {
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
    border-radius: 3px;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .photo:hover img {
    transform: scale(1.03);
  }

  /* A repeating rhythm of wide and tall frames, so a plain list of photos
     reads as a composed page rather than a uniform grid. */
  .photo:nth-child(6n + 1) {
    grid-column: span 4;
    aspect-ratio: 3 / 2;
  }
  .photo:nth-child(6n + 2) {
    grid-column: span 2;
    /* Shares a row with the wide frame above, so it takes that row's height
       instead of its own ratio — otherwise the row ends with a gap. */
    align-self: stretch;
  }
  .photo:nth-child(6n + 3),
  .photo:nth-child(6n + 4) {
    grid-column: span 3;
    aspect-ratio: 4 / 3;
  }
  .photo:nth-child(6n + 5),
  .photo:nth-child(6n + 6) {
    grid-column: span 3;
    aspect-ratio: 1 / 1;
  }
  /* A trailing odd photo spans the full width rather than leaving a hole. */
  .photo:last-child:nth-child(odd) {
    grid-column: span 6;
    aspect-ratio: 21 / 9;
  }

  @media (max-width: 780px) {
    .photo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .photo:nth-child(n) {
      grid-column: span 1;
      aspect-ratio: 3 / 4;
      align-self: auto;
    }
    .photo:nth-child(6n + 1),
    .photo:last-child:nth-child(odd) {
      grid-column: span 2;
      aspect-ratio: 3 / 2;
    }
  }
</style>
