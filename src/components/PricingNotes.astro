---
import { renderRichText } from '../lib/richText';
import type { Pricing } from '../lib/siteContent';

interface Props {
  notes: Pricing['notes'];
  /**
   * On /swieta the notes sit inside the dark price band rather than in a band
   * of their own, so they render as a block for that container to place — and
   * take the light text the dark ground needs.
   */
  dark?: boolean;
}

// The practical small print — booking, travel, extra photos — under whichever
// price list the visitor is reading. One set of notes serves both /cennik and
// /swieta, since the terms do not change with the season.
const { notes, dark = false } = Astro.props;
---

{
  notes.length > 0 &&
    (dark ? (
      <div class="notes notes--dark">
        {notes.map((note) => (
          <div>
            <h2>{note.title}</h2>
            <div class="note-body" set:html={renderRichText(note.text)} />
          </div>
        ))}
      </div>
    ) : (
      <section class="section">
        <div class="notes">
          {notes.map((note) => (
            <div>
              <h2>{note.title}</h2>
              <div class="note-body" set:html={renderRichText(note.text)} />
            </div>
          ))}
        </div>
      </section>
    ))
}

<style>
  .notes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    max-width: var(--max);
    margin: 0 auto;
  }
  .notes h2 {
    margin-bottom: 0.75rem;
    font-family: var(--body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--glina);
  }
  .note-body {
    font-size: 0.94rem;
    color: var(--tekst-jasny);
  }
  .note-body :global(p) {
    margin: 0;
  }
  .note-body :global(p + *),
  .note-body :global(ul + p),
  .note-body :global(ol + p) {
    margin-top: 0.7rem;
  }
  /* Bullets sit in the margin so the text keeps the column's left edge. */
  .note-body :global(ul),
  .note-body :global(ol) {
    margin: 0;
    padding-left: 1.1rem;
  }
  .note-body :global(li) {
    margin-bottom: 0.35rem;
  }
  .note-body :global(li)::marker {
    color: var(--taupe);
  }
  .note-body :global(li:last-child) {
    margin-bottom: 0;
  }
  .note-body :global(strong) {
    font-weight: 500;
    color: var(--tekst);
  }
  .note-body :global(a) {
    text-underline-offset: 3px;
  }

  /* Inside the price band: it follows the packages rather than opening a
     section, and the palette matches the rest of that band. */
  .notes--dark {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .notes--dark h2 {
    color: var(--taupe);
  }
  .notes--dark .note-body {
    color: #c3b8ac;
  }
  .notes--dark .note-body :global(strong) {
    color: var(--bez);
  }

  @media (max-width: 820px) {
    .notes {
      grid-template-columns: 1fr;
    }
  }
</style>
