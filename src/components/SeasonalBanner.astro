---
import Snowflake from './Snowflake.astro';
import type { Settings } from '../lib/siteContent';

interface Props {
  banner: Settings['seasonalBanner'];
}

const { banner } = Astro.props;
// Switched on and off from the panel — November on, January off.
const show = banner.active && banner.text;
---

{
  show && (
    <div class="banner">
      <span class="banner-flakes">
        <Snowflake />
        <Snowflake />
        <Snowflake />
      </span>
      <p class="banner-text">
        {banner.text}
        {banner.linkText && (
          <>
            {' · '}
            <a href={banner.linkHref}>{banner.linkText}</a>
          </>
        )}
      </p>
      <span class="banner-flakes banner-flakes--right">
        <Snowflake />
        <Snowflake />
        <Snowflake />
      </span>
    </div>
  )
}

<style>
  .banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    padding: 0.6rem 1rem;
    background: var(--glina);
    color: #fff9f2;
    text-align: center;
    font-size: 0.8rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  /* The global 62ch measure is for reading paragraphs; this is one line of
     announcement and would otherwise break at about 450px on any screen. */
  .banner-text {
    margin: 0;
    max-width: none;
  }

  /* Each side is a drift rather than a row of three identical marks: the sizes
     and the nudges differ, and the right-hand group runs backwards so it
     mirrors the left. They flank the whole message, so they stay centred
     against it on a phone where it runs to several lines. */
  .banner-flakes {
    display: flex;
    align-items: center;
    flex: none;
    gap: 0.35rem;
  }
  .banner-flakes--right {
    flex-direction: row-reverse;
  }
  .banner-flakes :global(.snowflake) {
    flex: none;
  }
  .banner-flakes :global(.snowflake:nth-child(1)) {
    width: 11px;
    height: 11px;
    transform: translateY(3px);
  }
  .banner-flakes :global(.snowflake:nth-child(2)) {
    width: 15px;
    height: 15px;
    transform: translateY(-3px);
  }
  .banner-flakes :global(.snowflake:nth-child(3)) {
    width: 12px;
    height: 12px;
    transform: translateY(2px);
  }

  .banner a {
    color: inherit;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  /* On a phone the drift has to leave the message room to break sensibly. */
  @media (max-width: 520px) {
    .banner {
      gap: 0.5rem;
    }
    .banner-flakes {
      gap: 0.2rem;
    }
    .banner-flakes :global(.snowflake:nth-child(1)) {
      width: 9px;
      height: 9px;
    }
    .banner-flakes :global(.snowflake:nth-child(2)) {
      width: 12px;
      height: 12px;
    }
    .banner-flakes :global(.snowflake:nth-child(3)) {
      width: 10px;
      height: 10px;
    }
  }
</style>
