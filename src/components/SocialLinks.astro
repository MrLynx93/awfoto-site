---
interface Props {
  facebook?: string;
  instagram?: string;
  /** Already-built wa.me link, or empty to hide it. */
  whatsapp?: string;
  class?: string;
}

const { facebook, instagram, whatsapp, class: className } = Astro.props;
---

<div class:list={['socials', className]}>
  {
    instagram && (
      <a href={instagram} aria-label="Instagram" rel="noopener noreferrer" target="_blank">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
          <circle cx="12" cy="12" r="4.2" />
          <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none" />
        </svg>
      </a>
    )
  }
  {
    facebook && (
      <a href={facebook} aria-label="Facebook" rel="noopener noreferrer" target="_blank">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M14.5 8.5V6.9c0-.8.5-1.4 1.3-1.4h1.5V2.6h-2.4c-2.4 0-3.7 1.5-3.7 3.9v2h-2.2v3h2.2v9h3.3v-9h2.4l.4-3h-2.8Z" />
        </svg>
      </a>
    )
  }
  {
    whatsapp && (
      <a href={whatsapp} aria-label="WhatsApp" rel="noopener noreferrer" target="_blank">
        <svg viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
          <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.39c0-4.54 3.7-8.23 8.24-8.23a8.2 8.2 0 0 1 8.23 8.24c0 4.54-3.69 8.24-8.23 8.24Zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.19-.54.06-.25-.12-1.05-.38-1.99-1.23-.74-.65-1.24-1.46-1.38-1.71-.15-.25-.02-.38.11-.5.11-.12.25-.29.37-.44.13-.15.17-.25.25-.42.09-.16.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.85-.2-.48-.4-.42-.55-.42h-.48c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.17 1.72 2.62 4.16 3.67.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.05.14-1.16-.06-.1-.22-.16-.47-.28Z" />
        </svg>
      </a>
    )
  }
</div>

<style>
  .socials {
    display: flex;
    gap: 0.9rem;
  }
  .socials a {
    display: grid;
    place-items: center;
    color: var(--tekst-jasny);
    transition: color 0.3s;
  }
  .socials a:hover {
    color: var(--glina);
  }
  .socials svg {
    width: 17px;
    height: 17px;
  }
</style>
