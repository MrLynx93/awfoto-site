---
import type { Pricing } from '../lib/siteContent';

interface Props {
  packages: Pricing['packages'];
}

const { packages } = Astro.props;
---

<div class="packages">
  {
    packages.map((item) => (
      <article class:list={['package', item.highlighted && 'package--highlight']}>
        <h3>
          {item.name}
          {item.badge && <span class="badge">{item.badge}</span>}
        </h3>
        <p class="price">
          {item.price}
          {item.duration && <small>{item.duration}</small>}
        </p>
        {item.includes.length > 0 && (
          <ul class="checklist">
            {item.includes.map((line) => (
              <li>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="m4 10.5 4 4 8-9" />
                </svg>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        )}
      </article>
    ))
  }
</div>

<style>
  /* The name, the price and the list are tracks of the row rather than of each
     card, so they line up across the three: a badge, or a name that wraps to a
     second line, lifts every card's price together instead of just its own.
     Cards are as tall as the tallest for the same reason — a package listing
     three things should not sit in a visibly smaller box. */
  .packages {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto auto;
    column-gap: clamp(1.25rem, 2.5vw, 2rem);
    row-gap: 1.25rem;
    align-items: stretch;
    margin-top: 3.5rem;
  }

  .package {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background: var(--biel);
    border: 1px solid var(--piaskowy);
    border-radius: 4px;
  }
  .package--highlight {
    background: var(--bez);
    border-color: var(--taupe);
    box-shadow: 0 18px 44px -30px rgba(74, 64, 56, 0.45);
  }

  .package h3 {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 1.9rem;
  }

  .badge {
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    background: var(--glina);
    color: #fff9f2;
    font-family: var(--body);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .price {
    font-family: var(--display);
    font-size: clamp(2.6rem, 5vw, 3.4rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .price small {
    display: block;
    margin-top: 0.6rem;
    font-family: var(--body);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tekst-jasny);
  }

  .checklist {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .checklist li {
    display: grid;
    grid-template-columns: 1.15rem 1fr;
    gap: 0.6rem;
    align-items: start;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--piaskowy);
    font-size: 0.94rem;
  }
  .checklist li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }
  .checklist svg {
    width: 15px;
    height: 15px;
    margin-top: 0.45rem;
    color: var(--szalwia);
  }

  @supports not (grid-template-rows: subgrid) {
    .package {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
  }

  /* One column: each card is its own block again, and the gap between them is
     the gap between cards rather than between a card's own rows. */
  @media (max-width: 900px) {
    .packages {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      row-gap: clamp(1.25rem, 2.5vw, 2rem);
      max-width: 26rem;
      margin-inline: auto;
    }
    .package {
      display: flex;
      flex-direction: column;
      grid-row: auto;
      gap: 1.25rem;
    }
  }
</style>
