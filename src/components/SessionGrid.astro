---
import SessionCard from './SessionCard.astro';
import type { Session } from '../lib/sessions';

interface Props {
  sessions: Session[];
  showIntro?: boolean;
  /** Drop the top margin when the grid is the first thing on a page. */
  flush?: boolean;
}

const { sessions, showIntro = false, flush = false } = Astro.props;
---

<div class:list={['session-grid', flush && 'session-grid--flush']}>
  {
    sessions.map((session, index) => (
      <SessionCard session={session} showIntro={showIntro} eager={index < 3} />
    ))
  }
</div>

<style>
  .session-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    margin-top: 3.5rem;
  }
  .session-grid--flush {
    margin-top: 0;
  }

  @media (max-width: 820px) {
    .session-grid {
      grid-template-columns: 1fr;
      max-width: 24rem;
      margin-inline: auto;
    }
  }
</style>
