---
import SocialLinks from './SocialLinks.astro';
import { getSettings, whatsappHref } from '../lib/siteContent';

const settings = getSettings();
const year = new Date().getFullYear();
const waHref = whatsappHref(settings.whatsapp);
---

<footer class="footer">
  <div class="footer-grid">
    <div>
      <a class="wordmark" href="/">AW<em>·</em>Fotografia</a>
      <p class="tagline">
        Fotografia rodzinna, plenerowa i świąteczna.
        {settings.city && <><br />{settings.city}</>}
      </p>
    </div>

    <div>
      <h2>Strona</h2>
      <ul class="footer-nav">
        <li><a href="/sesje">Moje sesje</a></li>
        <li><a href="/oferta">Oferta</a></li>
        {settings.christmas.active && <li><a href="/swieta">Święta</a></li>}
        <li><a href="/cennik">Cennik</a></li>
        <li><a href="/o-mnie">O mnie</a></li>
      </ul>
    </div>

    <div>
      <h2>Kontakt</h2>
      <ul class="footer-nav">
        {
          settings.phone && (
            <li>
              <a href={`tel:${settings.phone.replace(/\s/g, '')}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M5 3.5h3.5l1.8 4.4-2.2 1.6a12.5 12.5 0 0 0 6.4 6.4l1.6-2.2 4.4 1.8V19a1.6 1.6 0 0 1-1.7 1.6A16.7 16.7 0 0 1 3.4 5.2 1.6 1.6 0 0 1 5 3.5Z" />
                </svg>
                {settings.phone}
              </a>
            </li>
          )
        }
        {
          settings.email && (
            <li>
              <a href={`mailto:${settings.email}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
                  <path d="m3.5 7 8.5 6 8.5-6" />
                </svg>
                {settings.email}
              </a>
            </li>
          )
        }
        {
          waHref && (
            <li>
              <a href={waHref} rel="noopener noreferrer" target="_blank">
                WhatsApp
              </a>
            </li>
          )
        }
      </ul>
      <SocialLinks
        facebook={settings.facebook}
        instagram={settings.instagram}
        whatsapp={waHref}
        class="footer-socials"
      />
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {year} AW Fotografia</span>
    <a href="/polityka-prywatnosci">Polityka prywatności</a>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(2.25rem, 4vw, 3rem) var(--pad-x) 1.75rem;
    background: var(--tekst);
    color: #cfc5b9;
    font-size: 0.86rem;
  }

  /* One block under another rather than three columns. Both lists are a
     single line now, so stacking them stays short. */
  .footer-grid {
    display: grid;
    gap: 1.5rem;
    max-width: var(--max);
    margin: 0 auto;
  }

  .wordmark {
    font-family: var(--display);
    font-size: 1.15rem;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bez);
  }
  .wordmark em {
    font-style: normal;
    color: var(--glina);
  }

  .tagline {
    margin-top: 0.75rem;
    color: #a99e92;
    font-size: 0.88rem;
  }

  .footer h2 {
    margin-bottom: 0.5rem;
    font-family: var(--body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bez);
  }

  .footer ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Both lists read as one line separated by dots rather than a column,
     which is what keeps the stacked footer short. */
  .footer .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.5rem;
  }
  .footer .footer-nav li:not(:last-child)::after {
    content: '·';
    margin-left: 0.5rem;
    /* Sits a step below the links, but #6e6459 on this ground was invisible. */
    color: #a99e92;
  }

  .footer a {
    color: #cfc5b9;
    text-decoration: none;
    transition: color 0.3s;
  }

  /* The contact links lead with their icon, so the anchor lays them out
     rather than letting the glyph sit on the text baseline. */
  .footer-nav a:has(svg) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .footer-nav svg {
    width: 14px;
    height: 14px;
    flex: none;
    color: #a99e92;
  }
  .footer a:hover {
    color: var(--glina);
  }

  .footer :global(.footer-socials) {
    margin-top: 0.85rem;
  }
  .footer :global(.footer-socials a) {
    color: #a99e92;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    max-width: var(--max);
    margin: 2rem auto 0;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.76rem;
    color: #948a7f;
  }
</style>
