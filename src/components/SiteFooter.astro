---
import { getSettings, whatsappHref } from '../lib/siteContent';

const settings = getSettings();
const year = new Date().getFullYear();
const waHref = whatsappHref(settings.whatsapp);
---

<footer class="footer">
  <div class="footer-grid">
    <div>
      <a class="wordmark" href="/">AW<em>·</em>Fotografia</a>
      <p class="tagline">
        Fotografia rodzinna, plenerowa i świąteczna.
        {settings.city && <><br />{settings.city}</>}
      </p>
    </div>

    <div>
      <h2>Strona</h2>
      <ul class="footer-nav">
        <li><a href="/sesje">Moje sesje</a></li>
        <li><a href="/oferta">Oferta</a></li>
        {settings.christmas.active && <li><a href="/swieta">Święta</a></li>}
        <li><a href="/cennik">Cennik</a></li>
        <li><a href="/o-mnie">O mnie</a></li>
      </ul>
    </div>

    <div>
      <h2>Kontakt</h2>
      <ul class="footer-nav">
        {
          settings.phone && (
            <li>
              <a href={`tel:${settings.phone.replace(/\s/g, '')}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M5 3.5h3.5l1.8 4.4-2.2 1.6a12.5 12.5 0 0 0 6.4 6.4l1.6-2.2 4.4 1.8V19a1.6 1.6 0 0 1-1.7 1.6A16.7 16.7 0 0 1 3.4 5.2 1.6 1.6 0 0 1 5 3.5Z" />
                </svg>
                {settings.phone}
              </a>
            </li>
          )
        }
        {
          settings.email && (
            <li>
              <a href={`mailto:${settings.email}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
                  <path d="m3.5 7 8.5 6 8.5-6" />
                </svg>
                {settings.email}
              </a>
            </li>
          )
        }
        {
          settings.instagram && (
            <li>
              <a href={settings.instagram} aria-label="Instagram" rel="noopener noreferrer" target="_blank">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
                  <circle cx="12" cy="12" r="4.2" />
                  <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none" />
                </svg>
              </a>
            </li>
          )
        }
        {
          settings.facebook && (
            <li>
              <a href={settings.facebook} aria-label="Facebook" rel="noopener noreferrer" target="_blank">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M14.5 8.5V6.9c0-.8.5-1.4 1.3-1.4h1.5V2.6h-2.4c-2.4 0-3.7 1.5-3.7 3.9v2h-2.2v3h2.2v9h3.3v-9h2.4l.4-3h-2.8Z" />
                </svg>
              </a>
            </li>
          )
        }
        {
          waHref && (
            <li>
              <a href={waHref} aria-label="WhatsApp" rel="noopener noreferrer" target="_blank">
                <svg viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                  <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.39c0-4.54 3.7-8.23 8.24-8.23a8.2 8.2 0 0 1 8.23 8.24c0 4.54-3.69 8.24-8.23 8.24Zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.19-.54.06-.25-.12-1.05-.38-1.99-1.23-.74-.65-1.24-1.46-1.38-1.71-.15-.25-.02-.38.11-.5.11-.12.25-.29.37-.44.13-.15.17-.25.25-.42.09-.16.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.85-.2-.48-.4-.42-.55-.42h-.48c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.17 1.72 2.62 4.16 3.67.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.05.14-1.16-.06-.1-.22-.16-.47-.28Z" />
                </svg>
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {year} AW Fotografia</span>
    <a href="/polityka-prywatnosci">Polityka prywatności</a>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(2.25rem, 4vw, 3rem) var(--pad-x) 1.75rem;
    background: var(--tekst);
    color: #cfc5b9;
    font-size: 0.86rem;
  }

  /* One block under another rather than three columns. Both lists are a
     single line now, so stacking them stays short. */
  .footer-grid {
    display: grid;
    gap: 1.5rem;
    max-width: var(--max);
    margin: 0 auto;
  }

  .wordmark {
    font-family: var(--display);
    font-size: 1.15rem;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bez);
  }
  .wordmark em {
    font-style: normal;
    color: var(--glina);
  }

  .tagline {
    margin-top: 0.75rem;
    color: #a99e92;
    font-size: 0.88rem;
  }

  .footer h2 {
    margin-bottom: 0.5rem;
    font-family: var(--body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bez);
  }

  .footer ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Both lists read as one line separated by dots rather than a column,
     which is what keeps the stacked footer short. */
  .footer .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.5rem;
  }
  .footer .footer-nav li:not(:last-child)::after {
    content: '·';
    margin-left: 0.5rem;
    /* Sits a step below the links, but #6e6459 on this ground was invisible. */
    color: #a99e92;
  }

  .footer a {
    color: #cfc5b9;
    text-decoration: none;
    transition: color 0.3s;
  }

  /* The contact links lead with their icon, so the anchor lays them out
     rather than letting the glyph sit on the text baseline. */
  .footer-nav a:has(svg) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .footer-nav svg {
    width: 14px;
    height: 14px;
    flex: none;
    color: #a99e92;
  }
  /* The svg sets its own colour, so it would ignore the link's hover. */
  .footer-nav a:hover svg {
    color: var(--glina);
  }
  .footer a:hover {
    color: var(--glina);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    max-width: var(--max);
    margin: 2rem auto 0;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.76rem;
    color: #948a7f;
  }
</style>
