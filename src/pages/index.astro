---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionCard from '../components/SessionCard.astro';
import Carousel from '../components/Carousel.astro';
import OfferCard from '../components/OfferCard.astro';
import BotanicalDivider from '../components/BotanicalDivider.astro';
import ContactSection from '../components/ContactSection.astro';
import ChristmasFeature from '../components/ChristmasFeature.astro';
import { getSettings, getHome, getChristmas } from '../lib/siteContent';
import { publishedSessions } from '../lib/sessions';
import { cityName, sentences, websiteSchema } from '../lib/seo';

const settings = getSettings();
const home = getHome();
const christmas = getChristmas();

const sessions = await publishedSessions();
// Featured sessions first, newest otherwise. More than fills the row on
// purpose — the row scrolls, so the extras are what there is to scroll to.
const highlighted = [...sessions]
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 8);

const allOffers = (await getCollection('offers')).sort((a, b) => a.data.order - b.data.order);
const offers = allOffers.filter((offer) => offer.data.featured);

// In season the Christmas offer gets its own band straight below the hero —
// it is the year's main event, so it outranks everything but the headline.
const christmasOffer = christmas.active
  ? allOffers.find((offer) => offer.data.season === 'swiateczna')
  : undefined;

const heroSession = highlighted[0];
const heroImage = heroSession?.data.coverImage;

/**
 * The home page is the one result most people see first, so its title says the
 * trade and the town rather than only the studio's name — nobody searches for
 * a name they have not heard yet. The heading stays whatever she wrote.
 */
const city = cityName(settings.city);
const title = city
  ? `AW Fotografia — fotograf rodzinny i plenerowy, ${city}`
  : 'AW Fotografia — fotografia rodzinna, plenerowa i świąteczna';

// Her own words, but behind one line that says what this is and where, since
// the description is the other half of what Google prints.
const description = sentences(
  city ? `Sesje rodzinne, plenerowe, roczkowe i świąteczne — ${city} i okolice.` : undefined,
  home.text,
);
---

<BaseLayout title={title} description={description} schema={[websiteSchema(Astro.site!)]}>
  <section class="hero">
    <div>
      {home.eyebrow && <p class="label">{home.eyebrow}</p>}
      <h1>{home.heading}</h1>
      {home.text && <p class="hero-text">{home.text}</p>}
      <div class="buttons">
        <a class="button" href="#moje-sesje">Moje sesje</a>
        <a class="button button--ghost" href="/cennik">Cennik</a>
      </div>
    </div>

    {
      heroImage && (
        <Image
          class="hero-photo arch"
          src={heroImage}
          alt={heroSession.data.title}
          widths={[400, 800, 1200]}
          sizes="(max-width: 820px) 90vw, 45vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
  </section>

  {
    christmas.active && (
      <ChristmasFeature
        christmas={christmas}
        image={christmasOffer?.data.image}
        price={christmasOffer?.data.price}
      />
    )
  }

  <section class="section warm" id="moje-sesje">
    <div class="container">
      <div class="title-row">
        <div>
          <h2 class="section-title">Moje sesje</h2>
        </div>
        <a class="more-link" href="/sesje">Wszystkie sesje →</a>
      </div>
      <Carousel label="Moje sesje" dotLabel="Sesja">
        {highlighted.map((session, index) => (
          <SessionCard session={session} showIntro eager={index < 3} />
        ))}
      </Carousel>
    </div>
  </section>

  {
    offers.length > 0 && (
      <section class="section">
        <div class="container">
          <BotanicalDivider />
          <div class="centered heading-block">
            <p class="label">Oferta</p>
            <h2 class="section-title">Rodzaje sesji</h2>
          </div>
          <Carousel label="Rodzaje sesji" dotLabel="Oferta">
            {offers.map((offer) => (
              <OfferCard offer={offer} showMeta={false} />
            ))}
          </Carousel>
        </div>
      </section>
    )
  }

  <ContactSection
    settings={settings}
    heading="Zarezerwuj termin"
    lead="Najszybciej odpowiadam na Instagramie. Terminy weekendowe rezerwują się zwykle na miesiąc do przodu."
    withDivider
    warm
  />
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 6rem) var(--pad-x) var(--gap);
  }
  .hero h1 {
    font-size: clamp(3rem, 7.2vw, 5.6rem);
    line-height: 1.02;
    margin-bottom: 1.5rem;
  }
  .hero-text {
    margin-bottom: 2.25rem;
    color: var(--tekst-jasny);
  }
  .hero-photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .heading-block {
    margin-top: 2.5rem;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-photo {
      max-width: 22rem;
      margin-inline: auto;
    }
  }
</style>
