---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionGrid from '../components/SessionGrid.astro';
import OfferCard from '../components/OfferCard.astro';
import BotanicalDivider from '../components/BotanicalDivider.astro';
import ContactSection from '../components/ContactSection.astro';
import { getSettings } from '../lib/siteContent';
import { publishedSessions } from '../lib/sessions';

const settings = getSettings();

const sessions = await publishedSessions();
// Featured sessions first, newest otherwise; three fit the row.
const highlighted = [...sessions]
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);

const offers = (await getCollection('offers'))
  .filter((offer) => offer.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const heroImage = highlighted[0]?.data.coverImage;
---

<BaseLayout title="AW Fotografia" description={settings.heroText}>
  <section class="hero">
    <div>
      {settings.heroEyebrow && <p class="label">{settings.heroEyebrow}</p>}
      <h1>{settings.heroHeading}</h1>
      {settings.heroText && <p class="hero-text">{settings.heroText}</p>}
      <div class="buttons">
        <a class="button" href="/sesje">Moje sesje</a>
        <a class="button button--ghost" href="/cennik">Cennik</a>
      </div>
    </div>

    {
      heroImage && (
        <Image
          class="hero-photo arch"
          src={heroImage}
          alt=""
          widths={[400, 800, 1200]}
          sizes="(max-width: 820px) 90vw, 45vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
  </section>

  <section class="section warm">
    <div class="container">
      <div class="title-row">
        <div>
          <p class="label">Portfolio i aktualności w jednym</p>
          <h2 class="section-title">Moje sesje</h2>
        </div>
        <a class="more-link" href="/sesje">Wszystkie sesje →</a>
      </div>
      <SessionGrid sessions={highlighted} showIntro />
    </div>
  </section>

  {
    offers.length > 0 && (
      <section class="section">
        <div class="container">
          <BotanicalDivider />
          <div class="centered heading-block">
            <p class="label">Oferta</p>
            <h2 class="section-title">Rodzaje sesji</h2>
          </div>
          <div class="offers">
            {offers.map((offer) => (
              <OfferCard offer={offer} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section warm">
    <div class="about">
      <Image
        class="arch"
        src={import('../../blog-content/images/about/portret.jpg')}
        alt="Ania — fotografka"
        widths={[400, 700]}
        sizes="(max-width: 820px) 80vw, 35vw"
      />
      <div>
        <p class="label">O mnie</p>
        <h2 class="section-title">{settings.aboutHeading}</h2>
        <p>{settings.aboutText}</p>
        {settings.signature && <p class="signature">{settings.signature}</p>}
        <p class="about-more">
          <a class="more-link" href="/o-mnie">Więcej o mnie →</a>
        </p>
      </div>
    </div>
  </section>

  <ContactSection
    settings={settings}
    heading="Zarezerwuj termin"
    lead="Najszybciej odpowiadam na Instagramie. Terminy weekendowe rezerwują się zwykle na miesiąc do przodu."
    withDivider
  />
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 6rem) var(--pad-x) var(--gap);
  }
  .hero h1 {
    font-size: clamp(3rem, 7.2vw, 5.6rem);
    line-height: 1.02;
    margin-bottom: 1.5rem;
  }
  .hero-text {
    margin-bottom: 2.25rem;
    color: var(--tekst-jasny);
  }
  .hero-photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .heading-block {
    margin-top: 2.5rem;
  }

  .offers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3.5vw, 3rem);
    margin-top: 3.5rem;
  }

  .about {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5.5rem);
    max-width: var(--max);
    margin: 0 auto;
  }
  .about img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .signature {
    margin-top: 1.75rem;
    font-family: var(--display);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--glina);
  }
  .about-more {
    margin-top: 1.5rem;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-photo {
      max-width: 22rem;
      margin-inline: auto;
    }
    .offers {
      grid-template-columns: 1fr;
      max-width: 24rem;
      margin-inline: auto;
    }
    .about {
      grid-template-columns: 1fr;
    }
    .about img {
      max-width: 20rem;
    }
  }
</style>
