---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSettings, getPrivacy } from '../lib/siteContent';
import { getAnalytics } from '../lib/analytics';

const settings = getSettings();
const privacy = getPrivacy();
// The statistics section describes the tracker in BaseLayout, so it appears
// only in builds where that tracker is switched on.
const analytics = getAnalytics(Astro.site!);

/** The panel's boxes are plain text; a blank line starts a new paragraph. */
const paragraphs = (text: string) => text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

<BaseLayout
  title="Polityka prywatności"
  description="Jak przetwarzane są dane na stronie AW Fotografia."
  noindex
>
  <article class="legal">
    <p class="label">Informacja</p>
    <h1>Polityka prywatności</h1>

    {paragraphs(privacy.lead).map((p) => <p class="lead">{p}</p>)}

    <h2>Formularze</h2>
    {paragraphs(privacy.forms).map((p) => <p>{p}</p>)}

    <h2>Pliki cookies</h2>
    {paragraphs(privacy.cookies).map((p) => <p>{p}</p>)}

    {
      analytics && (
        <>
          <h2>Statystyki odwiedzin</h2>
          {paragraphs(privacy.statistics).map((p) => <p>{p}</p>)}
        </>
      )
    }

    <h2>Logi serwera</h2>
    {paragraphs(privacy.serverLogs).map((p) => <p>{p}</p>)}

    <h2>Zdjęcia</h2>
    {paragraphs(privacy.photos).map((p) => <p>{p}</p>)}

    <h2>Administrator danych</h2>
    <p>
      AW Fotografia.
      {settings.email && <> <a href={`mailto:${settings.email}`}>{settings.email}</a></>}
    </p>
  </article>
</BaseLayout>

<style>
  .legal {
    max-width: 42rem;
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 6rem) var(--pad-x) var(--gap);
  }
  .legal h1 {
    margin-bottom: 1.5rem;
    font-size: clamp(2.4rem, 5.5vw, 3.6rem);
  }
  .legal h2 {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.4rem;
  }
  .legal p {
    color: var(--tekst-jasny);
  }
  .legal .lead {
    margin-bottom: 1rem;
  }
  .legal a {
    color: var(--glina-ciemna);
  }
</style>
