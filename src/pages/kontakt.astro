---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import { getSettings } from '../lib/siteContent';

const settings = getSettings();
---

<BaseLayout
  title="Kontakt"
  description="Telefon, WhatsApp, e-mail, Instagram i Facebook — najszybszy sposób na rezerwację terminu."
>
  <header class="page-header">
    <p class="label">Kontakt</p>
    <h1>Napisz albo zadzwoń</h1>
    <p class="lead">
      Nie ma formularza — wolę zwykłą rozmowę. Najszybciej odpisuję
      na Instagramie i Facebooku.
    </p>
  </header>

  <ContactSection settings={settings} />
</BaseLayout>

<style>
  .page-header {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 6rem) var(--pad-x) 0;
    text-align: center;
  }
  .page-header h1 {
    margin-bottom: 1.25rem;
    font-size: clamp(2.8rem, 6.5vw, 4.5rem);
  }
  .page-header p {
    margin-inline: auto;
  }
</style>
