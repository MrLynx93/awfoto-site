---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingTable from '../components/PricingTable.astro';
import ContactSection from '../components/ContactSection.astro';
import PricingNotes from '../components/PricingNotes.astro';
import SnowyTitle from '../components/SnowyTitle.astro';
import { getChristmas, getChristmasPricing, getPricing, getSettings } from '../lib/siteContent';

const pricing = getPricing();
const settings = getSettings();
const christmas = getChristmas();
const christmasPricing = getChristmasPricing();

// One switch in the panel ("Sezon świąteczny") drives this block, the /swieta
// page and the menu link — turned on in November and off in January. The
// packages stay saved in between.
const showChristmas = christmas.active && christmasPricing.packages.length > 0;

// In season the Christmas packages are the offer, so they replace the
// year-round list rather than sitting under it.
const description = showChristmas
  ? 'Pakiety sesji świątecznych — co obejmują i ile kosztują.'
  : 'Pakiety sesji: co obejmują, ile trwają i ile kosztują.';
---

<BaseLayout title="Cennik" description={description}>
  {/* In season the Christmas band carries the page's own heading, so this one
      would sit above it saying the same thing about a list that is not there. */}
  {
    !showChristmas && (
      <header class="page-header">
        <p class="label">Cennik</p>
        <h1>Pakiety sesji</h1>
        {pricing.intro && <p class="lead">{pricing.intro}</p>}
      </header>
    )
  }

  {
    !showChristmas && (
      <section class="section">
        <div class="container">
          <PricingTable packages={pricing.packages} />
        </div>
      </section>
    )
  }

  {
    showChristmas && (
      <section class="section christmas">
        <div class="container">
          <div class="centered heading-block heading-block--lead">
            {christmasPricing.eyebrow && <p class="label">{christmasPricing.eyebrow}</p>}
            <SnowyTitle as="h1">{christmasPricing.title}</SnowyTitle>
            {christmasPricing.description && (
              <p class="lead">{christmasPricing.description}</p>
            )}
          </div>
          <PricingTable packages={christmasPricing.packages} />
          <PricingNotes notes={pricing.notes} dark />
          <p class="christmas-more">
            <a class="more-link" href="/swieta">
              Wszystko o sesjach świątecznych →
            </a>
          </p>
        </div>
      </section>
    )
  }

  {/* In season the notes sit inside the band above; out of season there is no
      band to sit in, so they get their own section under the year-round list. */}
  {!showChristmas && <PricingNotes notes={pricing.notes} />}

  <ContactSection
    settings={settings}
    heading="Masz pytanie o pakiet?"
    lead="Napisz — pomogę dobrać sesję do tego, czego naprawdę potrzebujecie."
    warm
  />
</BaseLayout>

<style>
  .page-header {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 6rem) var(--pad-x) 0;
    text-align: center;
  }
  .page-header h1 {
    margin-bottom: 1.25rem;
    font-size: clamp(2.8rem, 6.5vw, 4.5rem);
  }
  .page-header p {
    margin-inline: auto;
  }

  .heading-block {
    margin-top: 2.5rem;
  }
  /* Nothing precedes the Christmas block now, so it opens its band rather
     than following a divider off the list above. */
  .heading-block--lead {
    margin-top: 0;
  }

  /* The Christmas list is a dark band, so it reads as a separate offer rather
     than more of the same table. */
  .christmas {
    background: var(--tekst);
    color: var(--bez);
  }
  .christmas :global(.section-title),
  .christmas :global(.package h3),
  .christmas :global(.price) {
    color: var(--bez);
  }
  .christmas :global(.label) {
    color: var(--taupe);
  }
  .christmas :global(.lead) {
    color: #c3b8ac;
  }
  .christmas :global(.package) {
    background: rgba(255, 255, 255, 0.045);
    border-color: rgba(255, 255, 255, 0.16);
  }
  .christmas :global(.package--highlight) {
    background: rgba(176, 137, 104, 0.16);
    border-color: var(--glina);
    box-shadow: none;
  }
  .christmas :global(.checklist li) {
    border-bottom-color: rgba(255, 255, 255, 0.12);
  }
  .christmas :global(.checklist svg) {
    color: var(--taupe);
  }
  .christmas :global(.price small) {
    color: #b4a99d;
  }
  .christmas :global(.sprig) {
    color: var(--taupe);
  }

  .christmas-more {
    margin-top: 2.5rem;
    max-width: none;
    text-align: center;
  }
  .christmas-more :global(.more-link) {
    color: var(--bez);
    border-bottom-color: rgba(255, 255, 255, 0.35);
  }

</style>
