---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OfferCard from '../../components/OfferCard.astro';
import ContactSection from '../../components/ContactSection.astro';
import { getSettings } from '../../lib/siteContent';
import { renderRichText } from '../../lib/richText';

const settings = getSettings();
const { pages } = settings;
const offers = (await getCollection('offers')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Oferta"
  description="Rodzaje sesji: plenerowa, rodzinna, roczkowa i świąteczna."
>
  <header class="page-header">
    <p class="label">Oferta</p>
    <h1>{pages.offersHeading}</h1>
    {pages.offersIntro && (
      <div class="lead page-lead" set:html={renderRichText(pages.offersIntro)} />
    )}
  </header>

  <section class="section">
    <div class="container">
      <div class="offers">
        {offers.map((offer) => <OfferCard offer={offer} />)}
      </div>
    </div>
  </section>

  <ContactSection
    settings={settings}
    heading="Nie wiesz, co wybrać?"
    lead="Napisz, opowiedz o okazji — podpowiem, która sesja pasuje najlepiej."
    warm
  />
</BaseLayout>

<style>
  .page-header {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 6rem) var(--pad-x) 0;
    text-align: center;
  }
  .page-header h1 {
    margin-bottom: 1.25rem;
    font-size: clamp(2.8rem, 6.5vw, 4.5rem);
  }
  .page-header p {
    margin-inline: auto;
  }
  /* The intro is rich text from the panel, so its paragraphs arrive without
     this component's scope attribute and the rule above cannot reach them. */
  .page-lead :global(p) {
    margin: 0 auto;
  }
  .page-lead :global(p + p) {
    margin-top: 0.8rem;
  }

  .offers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3.5vw, 3rem);
  }

  @media (max-width: 820px) {
    .offers {
      grid-template-columns: 1fr;
      max-width: 24rem;
      margin-inline: auto;
    }
  }
</style>
