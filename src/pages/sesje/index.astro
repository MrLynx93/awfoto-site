---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SessionGrid from '../../components/SessionGrid.astro';
import { publishedSessions } from '../../lib/sessions';
import { getSessionsPage } from '../../lib/siteContent';
import { renderRichText } from '../../lib/richText';

const sessions = await publishedSessions();
const page = getSessionsPage();
---

<BaseLayout
  title="Moje sesje"
  description="Sesje rodzinne, plenerowe, roczkowe i świąteczne."
>
  <header class="page-header">
    <h1>{page.heading}</h1>
    {page.intro && (
      <div class="lead page-lead" set:html={renderRichText(page.intro)} />
    )}
  </header>

  <section class="section">
    <div class="container">
      {
        sessions.length > 0 ? (
          <SessionGrid sessions={sessions} flush />
        ) : (
          <p class="lead centered">Pierwsze sesje pojawią się tu wkrótce.</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 6rem) var(--pad-x) 0;
    text-align: center;
  }
  .page-header h1 {
    font-size: clamp(2.8rem, 6.5vw, 4.5rem);
    margin-bottom: 1.25rem;
  }
  .page-header p {
    margin-inline: auto;
  }
  /* The intro is rich text from the panel, so its paragraphs arrive without
     this component's scope attribute and the rule above cannot reach them. */
  .page-lead :global(p) {
    margin: 0 auto;
  }
  .page-lead :global(p + p) {
    margin-top: 0.8rem;
  }
</style>
