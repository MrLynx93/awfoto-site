---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import Lightbox from '../../components/Lightbox.astro';
import SessionCard from '../../components/SessionCard.astro';
import Carousel from '../../components/Carousel.astro';
import ContactSection from '../../components/ContactSection.astro';
import { getSettings } from '../../lib/siteContent';
import { publishedSessions, otherSessions, formatDate, type Session } from '../../lib/sessions';
import { breadcrumbSchema, cityName, sentences, sessionSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const sessions = await publishedSessions();
  return sessions.map((session) => ({
    params: { slug: session.id },
    props: { session, others: otherSessions(sessions, session, 8) },
  }));
}

interface Props {
  session: Session;
  others: Session[];
}

const { session, others } = Astro.props;
const { title, date, tags, intro, photos, coverImage } = session.data;
const settings = getSettings();

// The body is optional — most sessions are just the intro plus photos.
const { Content } = await render(session);

const meta = [formatDate(date), ...tags].filter(Boolean).join(' · ');

const city = cityName(settings.city);
const url = new URL(Astro.url.pathname, Astro.site);

// The kind of shoot up front — someone searching "sesja roczkowa Żory"
// needs the description to say that, and the intro is a story, not a label.
const description = sentences(
  tags.length > 0 ? `${tags.join(', ')} — ${city || 'sesja zdjęciowa'}.` : undefined,
  intro,
);

/**
 * A dated page of photographs by a named author, tied to the business. This is
 * what puts a shoot's pictures into Google Images with the page behind them —
 * the main way a portfolio is found by someone who was not looking for it.
 */
const schema = [
  breadcrumbSchema(Astro.site!, [
    { name: 'Moje sesje', path: '/sesje' },
    { name: title, path: Astro.url.pathname },
  ]),
  sessionSchema(Astro.site!, {
    title,
    intro,
    date,
    tags,
    url,
    images: [
      { src: coverImage.src, width: coverImage.width, height: coverImage.height, alt: title },
      ...photos.map((photo) => ({
        src: photo.image.src,
        width: photo.image.width,
        height: photo.image.height,
        alt: photo.alt,
      })),
    ],
  }),
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={coverImage.src}
  ogType="article"
  publishedTime={date.toISOString()}
  schema={schema}
>
  <header class="session-header">
    <p class="session-date">{meta}</p>
    <h1>{title}</h1>
    <p class="session-intro">{intro}</p>
  </header>

  <section class="section session-body">
    <div class="prose">
      <Content />
    </div>
  </section>

  <section class="section session-gallery">
    <PhotoGallery photos={photos} />
  </section>

  {
    others.length > 0 && (
      <section class="section warm other-sessions">
        <div class="container">
          <div class="title-row">
            <div>
              <p class="label">Zobacz też</p>
              <h2 class="section-title">Inne sesje</h2>
            </div>
            <a class="more-link" href="/sesje">
              Wszystkie sesje →
            </a>
          </div>
          <Carousel label="Inne sesje" dotLabel="Sesja">
            {others.map((other) => (
              <SessionCard session={other} />
            ))}
          </Carousel>
        </div>
      </section>
    )
  }

  <ContactSection
    settings={settings}
    heading="Chcesz taką sesję?"
    lead="Napisz — dobierzemy termin i miejsce."
  />

  <Lightbox />
</BaseLayout>

<style>
  .session-header {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 5.5rem) var(--pad-x) 0;
    text-align: center;
  }
  .session-header h1 {
    margin: 0.75rem 0 1.5rem;
    font-size: clamp(2.6rem, 6vw, 4.2rem);
  }
  .session-date {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--szalwia);
  }
  .session-intro {
    margin-inline: auto;
    color: var(--tekst-jasny);
  }

  /* Collapses to nothing when a session has no body text, so the gallery
     follows the intro directly. */
  .session-body {
    padding-block: 0;
    padding-top: var(--gap-sm);
  }
  .session-body:not(:has(.prose > *)) {
    display: none;
  }

  .session-gallery {
    padding-top: var(--gap-sm);
  }
  .prose {
    max-width: 40rem;
    margin: 0 auto;
    color: var(--tekst-jasny);
  }
  .prose :global(p) {
    margin-bottom: 1.25rem;
  }
  .prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .prose:empty {
    display: none;
  }

  .other-sessions {
    border-top: 1px solid var(--piaskowy);
    margin-top: var(--gap);
  }
</style>
